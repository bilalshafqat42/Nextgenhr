# Settings for sending contact form enquiries by email (the mailbox is on Titan Mail).
# Do NOT put real passwords in this file. Add the real values in Hostinger's environment variables
# (or in a local .env file, which git ignores).

SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=info@nextgenhr.ae
SMTP_PASS=your-mailbox-password
CONTACT_TO=info@nextgenhr.ae
